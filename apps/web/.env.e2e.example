# E2E environment contract — NON-SECRET TEMPLATE
#
# Copy to `.env.e2e.local` (untracked) and fill in the operator-local values.
# Canonical identity for every field below: docs/Execution/ENVIRONMENT-IDENTITY.md
#
# Never commit a real key, token or password to this file.

# ---------------------------------------------------------------------------
# Target environment
# ---------------------------------------------------------------------------

# Canonical Review web application base URL. Non-secret; safe to version once the
# Review deployment exists. Until then this stays a placeholder and no E2E run may
# claim Review coverage.
E2E_BASE_URL=

# Guard: the E2E harness must assert that the application under test is bound to
# this Supabase project and refuse to run otherwise.
E2E_SUPABASE_PROJECT_REF=rwfvxvbzaosgcyfxdjpt

# ---------------------------------------------------------------------------
# Supabase access for the runner
# ---------------------------------------------------------------------------
# These are read by the Playwright runner only (apps/web/e2e/**). They are never
# bundled, never sent to a browser context and never written to storage state.

# Review project API URL. The harness derives the project ref from this host and
# refuses to run if it is Production or Legacy.
E2E_SUPABASE_URL=https://rwfvxvbzaosgcyfxdjpt.supabase.co

# Review anon (publishable) key. Used to sign synthetic users in so the tenant can
# be created through the real `create_company_with_owner` boundary.
E2E_SUPABASE_ANON_KEY=

# Review service-role key. SECRET. Used only for Admin-API user creation, member
# bootstrap and teardown, all inside the runner process.
E2E_SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Synthetic identities
# ---------------------------------------------------------------------------
# Addresses are generated per run as e2e+<run-id>-<role>@<domain>; passwords are
# random per run and never leave the untracked run directory. Nothing here is a
# long-lived account, so no credentials belong in this file.
#
# Default is an RFC 2606 reserved TLD that can never receive mail. Override only if
# Supabase rejects it, and then use a domain you control.
E2E_EMAIL_DOMAIN=evol-e2e.invalid

# ---------------------------------------------------------------------------
# Harness behaviour
# ---------------------------------------------------------------------------

# Hard safety interlock. The harness refuses to run against any Supabase ref other
# than E2E_SUPABASE_PROJECT_REF, and never against Production (gzrrwyiqfbnyprkdeqvm)
# or Legacy (oudngmrdtgengilpqqnz) at all. Setting this true only permits a local
# stack for harness debugging — such a run is NOT Review release evidence.
E2E_ALLOW_NON_REVIEW_TARGET=false
