{
  "name": "@evol/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test:projection": "tsx --test src/features/organization-planning/projection/**/*.test.ts",
    "test:route-ordering": "tsx --test src/features/people/profile/*.test.ts",
    "e2e": "playwright test",
    "e2e:review": "npm run e2e:preflight --silent && npm run e2e:install --silent && npm run e2e",
    "e2e:preflight": "tsx e2e/preflight.ts",
    "e2e:set-service-key": "tsx e2e/set-service-key.ts",
    "e2e:inspect-key": "tsx e2e/inspect-key.ts",
    "e2e:install": "playwright install chromium",
    "e2e:report": "playwright show-report e2e/.run/report",
    "test:e2e-helpers": "tsx --test e2e/helpers/*.test.ts e2e/fixtures/*.test.ts e2e/lifecycle/*.test.ts e2e/*.test.ts",
    "e2e:cleanup": "tsx e2e/cleanup.ts",
    "e2e:inspect-run": "tsx e2e/inspect-run.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@phosphor-icons/react": "^2.1.10",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.45.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "next": "15.5.20",
    "openai": "^6.48.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "resend": "^6.18.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2.5.4",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "eslint": "^9.14.0",
    "eslint-config-next": "15.5.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.23.1",
    "typescript": "5.6.3"
  }
}
