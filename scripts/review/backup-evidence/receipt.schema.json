{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Consumption result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "claim_sha256",
    "contract_version",
    "evidence_id",
    "operation_id",
    "project_ref",
    "recorded_at",
    "result"
  ],
  "properties": {
    "claim_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "contract_version": {
      "const": 1
    },
    "evidence_id": {
      "type": "string",
      "format": "uuid"
    },
    "operation_id": {
      "type": "string",
      "minLength": 1
    },
    "project_ref": {
      "const": "rwfvxvbzaosgcyfxdjpt"
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "result": {
      "enum": [
        "APPLIED_AND_VERIFIED",
        "UNKNOWN_REMOTE_OUTCOME",
        "POST_FAILED_DO_NOT_RETRY"
      ]
    }
  }
}
